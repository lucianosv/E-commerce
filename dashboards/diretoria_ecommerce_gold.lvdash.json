{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (gold)",
      "columns": [
        {
          "displayName": "Vendas",
          "description": "Quantidade de vendas",
          "expression": "SUM(`total_vendas`)"
        },
        {
          "displayName": "Ticket médio",
          "description": "Receita dividida pelo número de vendas",
          "expression": "SUM(`receita`) / SUM(`total_vendas`)"
        }
      ],
      "queryLines": [
        "SELECT data, dia_semana, dia_semana_num, hora, canal_venda, total_vendas, itens_vendidos, receita\n",
        "FROM vendas_temporais\n"
      ]
    },
    {
      "name": "ds_top_produtos",
      "displayName": "Top 10 produtos (gold)",
      "queryLines": [
        "SELECT nome_produto, categoria, itens_vendidos, receita, ranking_receita\n",
        "FROM vendas_produtos\n",
        "WHERE ranking_receita <= 10\n",
        "ORDER BY ranking_receita\n"
      ]
    },
    {
      "name": "ds_clientes",
      "displayName": "Clientes (gold)",
      "queryLines": [
        "SELECT id_cliente, nome_cliente, estado, regiao, segmento_cliente, total_compras, receita, ticket_medio, ranking_receita\n",
        "FROM clientes_segmentacao\n",
        "ORDER BY ranking_receita\n"
      ]
    },
    {
      "name": "ds_precos",
      "displayName": "Competitividade (gold)",
      "queryLines": [
        "SELECT\n",
        "  id_produto, nome_produto, categoria, nosso_preco, preco_maximo_concorrentes,\n",
        "  diferenca_pct_vs_media / 100 AS diferenca_vs_media,\n",
        "  classificacao_preco, receita\n",
        "FROM precos_competitividade\n"
      ]
    }
  ],
