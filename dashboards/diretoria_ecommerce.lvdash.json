{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (bronze)",
      "columns": [
        {
          "displayName": "Vendas",
          "description": "Quantidade de vendas",
          "expression": "SUM(`total_vendas`)"
        },
        {
          "displayName": "Ticket médio",
          "description": "Receita dividida pelo número de vendas",
          "expression": "SUM(`receita`) / SUM(`total_vendas`)"
        }
      ],
      "queryLines": [
        "SELECT\n",
        "  DATE(v.data_venda)                        AS data,\n",
        "  v.canal_venda,\n",
        "  COALESCE(p.categoria, 'Não cadastrado')   AS categoria,\n",
        "  COUNT(*)                                  AS total_vendas,\n",
        "  SUM(v.quantidade)                         AS itens_vendidos,\n",
        "  SUM(v.quantidade * v.preco_unitario)      AS receita\n",
        "FROM ecommerce.bronze.vendas v\n",
        "LEFT JOIN ecommerce.bronze.produtos p ON v.id_produto = p.id_produto\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_top_produtos",
      "displayName": "Top 10 produtos (bronze)",
      "queryLines": [
        "SELECT\n",
        "  p.nome_produto,\n",
        "  p.categoria,\n",
        "  SUM(v.quantidade)                    AS itens_vendidos,\n",
        "  SUM(v.quantidade * v.preco_unitario) AS receita\n",
        "FROM ecommerce.bronze.vendas v\n",
        "JOIN ecommerce.bronze.produtos p ON v.id_produto = p.id_produto\n",
        "GROUP BY p.nome_produto, p.categoria\n",
        "ORDER BY receita DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "ds_clientes",
      "displayName": "Clientes (bronze)",
      "queryLines": [
        "SELECT\n",
        "  c.id_cliente,\n",
        "  c.nome_cliente,\n",
        "  c.estado,\n",
        "  COUNT(*)                                  AS total_compras,\n",
        "  SUM(v.quantidade * v.preco_unitario)      AS receita,\n",
        "  AVG(v.quantidade * v.preco_unitario)      AS ticket_medio\n",
        "FROM ecommerce.bronze.vendas v\n",
        "JOIN ecommerce.bronze.clientes c ON v.id_cliente = c.id_cliente\n",
        "GROUP BY c.id_cliente, c.nome_cliente, c.estado\n",
        "ORDER BY receita DESC\n"
      ]
    },
    {
      "name": "ds_precos",
      "displayName": "Competitividade (bronze)",
      "queryLines": [
        "SELECT\n",
        "  p.id_produto,\n",
        "  p.nome_produto,\n",
        "  p.categoria,\n",
        "  p.preco_atual                                                  AS nosso_preco,\n",
        "  MAX(pc.preco_concorrente)                                      AS preco_maximo_concorrentes,\n",
        "  (p.preco_atual - AVG(pc.preco_concorrente)) / AVG(pc.preco_concorrente) AS diferenca_vs_media,\n",
        "  CASE\n",
        "    WHEN p.preco_atual > MAX(pc.preco_concorrente) THEN 'MAIS_CARO_QUE_TODOS'\n",
        "    WHEN p.preco_atual < MIN(pc.preco_concorrente) THEN 'MAIS_BARATO_QUE_TODOS'\n",
        "    WHEN p.preco_atual > AVG(pc.preco_concorrente) THEN 'ACIMA_DA_MEDIA'\n",
        "    WHEN p.preco_atual < AVG(pc.preco_concorrente) THEN 'ABAIXO_DA_MEDIA'\n",
        "    ELSE 'NA_MEDIA'\n",
        "  END                                                            AS classificacao_preco,\n",
        "  COALESCE(r.receita, 0)                                         AS receita\n",
        "FROM ecommerce.bronze.produtos p\n",
        "JOIN ecommerce.bronze.preco_competidores pc ON p.id_produto = pc.id_produto\n",
        "LEFT JOIN (\n",
        "  SELECT id_produto, SUM(quantidade * preco_unitario) AS receita FROM ecommerce.bronze.vendas GROUP BY id_produto\n",
        ") r ON p.id_produto = r.id_produto\n",
        "GROUP BY p.id_produto, p.nome_produto, p.categoria, p.preco_atual, r.receita\n"
      ]
    }
  ],
